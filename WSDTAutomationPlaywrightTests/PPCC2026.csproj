<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
	<RootNamespace>PPCC2026</RootNamespace>
	<Configurations>Debug;Release;GenerateXRMTypes</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.0" />
    <PackageReference Include="Bogus" Version="35.6.5" />
    <PackageReference Include="ExtentReports" Version="5.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageReference Include="Microsoft.Playwright.NUnit" Version="1.62.0" />
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.26" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

	<ItemGroup>
		<None Update="Config\appsettings*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Update="Config\*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="TestFixture\" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="TestFixture\UITest.json">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

	<PropertyGroup>
		<GenerateXRMTypes>false</GenerateXRMTypes>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'GenerateXRMTypes'">
		<GenerateXRMTypes>true</GenerateXRMTypes>
	</PropertyGroup>

	<Target Name="GenerateDataverseTypes" BeforeTargets="BeforeBuild" Condition="'$(GenerateXRMTypes)' == 'true'&#xD;&#xA;			and '$(DesignTimeBuild)' != 'true'">

		<PropertyGroup>
			<GenerateTypesScript>$(MSBuildProjectDirectory)\Scripts\GenerateTypes.ps1</GenerateTypesScript>
			<GenerateTypesStartPath>$(MSBuildProjectDirectory)\Scripts</GenerateTypesStartPath>
		</PropertyGroup>


		<Message Importance="high" Text="Generating Dataverse early-bound types into Entities\Context..." />
		
		<Message Importance="high" Text="MSBuildProjectDirectory=[$(MSBuildProjectDirectory)]" />

		<Message Importance="high" Text="GenerateTypesScript=[$(GenerateTypesScript)]" />

		<Message Importance="high" Text="GenerateTypesStartPath=[$(GenerateTypesStartPath)]" />

		<Error Condition="!Exists('$(GenerateTypesScript)')" Text="Missing file: $(GenerateTypesScript)" />

		<Error Condition="!Exists('$(GenerateTypesStartPath)\_GenerateTypes.ps1')" Text="Missing file: $(GenerateTypesStartPath)\_GenerateTypes.ps1" />

		<Error Condition="!Exists('$(GenerateTypesStartPath)\_Config.ps1')" Text="Missing file: $(GenerateTypesStartPath)\_Config.ps1" />

		<Error Condition="!Exists('$(GenerateTypesStartPath)\_SetupTools.ps1')" Text="Missing file: $(GenerateTypesStartPath)\_SetupTools.ps1" />

		<Error Condition="!Exists('$(GenerateTypesStartPath)\config.json')" Text="Missing file: $(GenerateTypesStartPath)\config.json" />

		<Error Condition="!Exists('$(MSBuildProjectDirectory)\XrmContext\XrmContext.exe.config')" Text="Missing file: $(MSBuildProjectDirectory)\XrmContext\XrmContext.exe.config" />

		<Exec Command="powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File &quot;$(GenerateTypesScript)&quot; -StartPath &quot;$(GenerateTypesStartPath)&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="high" StandardErrorImportance="high" IgnoreStandardErrorWarningFormat="true" />

		<ItemGroup>
			<PackageReference Include="Delegate.XrmContext" Version="3.0.1" GeneratePathProperty="true" />
		</ItemGroup>
		
	</Target>
	
</Project>
